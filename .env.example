UPTIME_KUMA_URL=https://uptime.bay-ram.de
# Variante A: API-Key (UK >= 1.23, Settings → API Keys → Create New)
UPTIME_KUMA_TOKEN=
# Variante B: User + Password (Fallback wenn kein Token gesetzt)
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

MCP_API_KEY=<random-32-bytes-hex>
OIDC_INTROSPECTION_URL=https://authelia.bay-ram.de/api/oidc/introspection
OIDC_CLIENT_ID=uptime-kuma-mcp
OIDC_CLIENT_SECRET=<random>

LOG_LEVEL=INFO
MCP_TRANSPORT=sse
PORT=8000
